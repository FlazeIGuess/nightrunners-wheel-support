<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline generator for the Il2Cpp interop assemblies.
    Mirrors BepInEx.Unity.IL2CPP.Il2CppInteropManager exactly (Cpp2IL + Il2CppInterop.Generator).
    References the tool DLLs from the BepInEx BE core (via CoreDir), so the generated interop
    assemblies are deterministically identical to the ones BepInEx generates at runtime.

    Invoke via tools/gen-interop.sh (recommended). Arguments to InteropGen:
      GameAssembly.dll  global-metadata.dat  2019.4.41  unity-libs/  out/
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>InteropGen</AssemblyName>
    <RootNamespace>InteropGen</RootNamespace>
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
    <!-- Path to the BepInEx BE core; overridable via -p:CoreDir=... -->
    <CoreDir Condition="'$(CoreDir)' == ''">$(MSBuildThisFileDirectory)../../.cache/bepinex/BepInEx/core/</CoreDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(CoreDir)*.dll" Exclude="$(CoreDir)dobby.dll" />
  </ItemGroup>

</Project>
